# Managed by Ansible
NODE_ENV=production
PORT={{ app_port }}
MONGO_URI=mongodb://{{ mongodb_app_user }}:{{ mongodb_app_password | urlencode }}@{{ mongo_host }}:{{ mongodb_port }}/{{ mongodb_app_db }}?authSource={{ mongodb_app_db }}
# Browser origin(s) allowed to call the API
CORS_ORIGIN=http://{{ public_host }}{% if app_extra_origins is defined %},{{ app_extra_origins }}{% endif %}

UPLOAD_DIR={{ app_dir }}/uploads
MAX_UPLOAD_MB=5
# One proxy (nginx) in front of Express
TRUST_PROXY=1
