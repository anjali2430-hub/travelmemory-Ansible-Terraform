# Generated by Terraform - do not edit by hand (re-run `terraform apply`).

[webservers]
web ansible_host=${web_public_ip} private_ip=${web_private_ip}

[dbservers]
db ansible_host=${db_private_ip} private_ip=${db_private_ip}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${key_file}
public_host=${web_public_ip}
admin_cidr=${admin_cidr}
vpc_cidr=${vpc_cidr}

[dbservers:vars]
# The DB server has no public IP: tunnel through the web server (bastion)
ansible_ssh_common_args='-o ProxyCommand="ssh -W %h:%p -q -i ${key_file} -o StrictHostKeyChecking=accept-new ubuntu@${web_public_ip}"'
